# Credentials for the tapp deployment. Copy to bot.env and fill in.
#
# bot.env is uploaded to the CVM by tapp-cli and hashed into the runtime
# measurement; only the hash is published, never the contents. Everything here
# is a secret the deployer already holds, which is the distinction that makes
# this the right place for it -- unlike the signing key, which is derived inside
# the TEE and never leaves it.
#
# NO PRIVATE KEYS. OPERATOR_PK and ORACLE_UPDATER_PK are set at runtime from the
# TEE-derived key; anything put here under those names is overwritten.
#
# Upload it over the TLS port (:50052, pinned with --tls-pin), not the plaintext
# one -- this file is the only part of the deployment that carries secrets, and a
# hardened image has no SSH to tunnel through. See docs/TAPP_DEPLOY.md.

TELEGRAM_BOT_API_KEY=
TELEGRAM_GROUP_CHAT_ID=

# Comma-separated endpoints are supported and fail over per request.
TARGET_RPC=
ZG_RPC=
